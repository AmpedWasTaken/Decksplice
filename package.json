{
  "name": "decksplice",
  "version": "0.2.0",
  "description": "CLI-first DJ library preparation toolkit",
  "type": "module",
  "bin": {
    "decksplice": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmpedWasTaken/Decksplice.git"
  },
  "homepage": "https://github.com/AmpedWasTaken/Decksplice#readme",
  "bugs": {
    "url": "https://github.com/AmpedWasTaken/Decksplice/issues"
  },
  "keywords": [
    "dj",
    "spotify",
    "rekordbox",
    "flac",
    "aiff",
    "wav",
    "lossless",
    "playlist",
    "usb",
    "cdj",
    "hot-cues",
    "ffmpeg",
    "cli"
  ]
}
